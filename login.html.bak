<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Pawprint Delight - Caretaker Login</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;family=Be+Vietnam+Pro:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "tertiary-dim": "#005d1a",
                        "surface-tint": "#914539",
                        "surface-container-low": "#f6f0e6",
                        "on-error": "#ffefee",
                        "surface-container": "#ede7dd",
                        "surface-variant": "#e2dcd1",
                        "secondary-container": "#9ae1ff",
                        "surface-bright": "#fcf6ed",
                        "surface-container-highest": "#e2dcd1",
                        "on-primary": "#ffefed",
                        "on-primary-fixed-variant": "#6b281e",
                        "primary-dim": "#82392e",
                        "on-tertiary-fixed": "#004e15",
                        "tertiary-fixed-dim": "#8ef08e",
                        "error-container": "#fb5151",
                        "inverse-on-surface": "#a19c95",
                        "primary": "#914539",
                        "on-secondary": "#e3f6ff",
                        "on-surface-variant": "#5e5b54",
                        "surface-container-lowest": "#ffffff",
                        "inverse-surface": "#100e09",
                        "outline-variant": "#b1ada5",
                        "surface-container-high": "#e8e2d7",
                        "on-secondary-fixed": "#003d4f",
                        "primary-fixed-dim": "#ee8f7f",
                        "tertiary-container": "#9bff9b",
                        "secondary-fixed-dim": "#8cd3f0",
                        "secondary-dim": "#00576e",
                        "surface": "#fcf6ed",
                        "inverse-primary": "#fe9c8c",
                        "on-primary-fixed": "#400804",
                        "secondary": "#04647d",
                        "secondary-fixed": "#9ae1ff",
                        "on-tertiary": "#d0ffca",
                        "on-tertiary-fixed-variant": "#006f21",
                        "on-surface": "#312e29",
                        "surface-dim": "#dad4c8",
                        "tertiary": "#006b1f",
                        "on-tertiary-container": "#00631d",
                        "on-background": "#312e29",
                        "outline": "#7a766f",
                        "tertiary-fixed": "#9bff9b",
                        "primary-container": "#fe9c8c",
                        "background": "#fcf6ed",
                        "on-error-container": "#570008",
                        "error-dim": "#9f0519",
                        "on-primary-container": "#5f1f16",
                        "primary-fixed": "#fe9c8c",
                        "on-secondary-container": "#005267",
                        "on-secondary-fixed-variant": "#005c74",
                        "error": "#b31b25"
                    },
                    "borderRadius": {
                        "DEFAULT": "1rem",
                        "lg": "2rem",
                        "xl": "3rem",
                        "full": "9999px"
                    },
                    "fontFamily": {
                        "headline": ["Plus Jakarta Sans"],
                        "body": ["Plus Jakarta Sans"],
                        "label": ["Be Vietnam Pro"]
                    }
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .bubbly-gradient {
            background: linear-gradient(135deg, #ffffff 0%, #fff5f2 100%);
        }
        .floating-blob {
            position: absolute;
            z-index: -1;
            filter: blur(60px);
            opacity: 0.4;
            border-radius: 50%;
        }
    </style>
</head>
<body class="bg-background font-body text-on-surface min-h-screen flex items-center justify-center overflow-hidden selection:bg-primary-container selection:text-on-primary-container">
<!-- Decorative Blobs -->
<div class="floating-blob w-96 h-96 bg-primary-fixed-dim -top-20 -left-20 animate-pulse"></div>
<div class="floating-blob w-80 h-80 bg-secondary-fixed-dim bottom-10 right-10"></div>
<div class="floating-blob w-64 h-64 bg-tertiary-fixed-dim top-1/2 left-1/3"></div>
<main class="relative z-10 w-full max-w-[1200px] px-6 flex flex-col md:flex-row items-center justify-center gap-12">
<!-- Illustration Container (Dog & Cat Peeking) -->
<div class="hidden lg:block relative w-1/2 max-w-md">
<div class="absolute -right-4 -top-20 z-0 opacity-20">
<span class="material-symbols-outlined text-[12rem] text-primary" data-icon="potted_plant">potted_plant</span>
</div>
<div class="relative z-10 bg-surface-container-low rounded-xl p-8 transform -rotate-3 shadow-xl">
<img alt="Happy dog and cat" class="w-full h-[400px] object-cover rounded-lg" data-alt="Close-up of a smiling golden retriever and a fluffy calico cat peeking over a soft cream-colored ledge with bright natural lighting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAc7k6Juc1vP7A81Nyh1PM2loUBcCIX_UpzWH257kDcKFKeKWCaeATGIdf-AvAqhWckpAIKFDKLHwYu4QLZbYHAXDdZO8T1zUbp-xPSaPsPO76enL1rKUeX3YIhESUlLyHxOLt_vELgZpxNFShkTCXAfJI-MOTWhiBWDplmH1UtM8_k7sY9VF5m-zGnM7yMQUsqTIAtjeIRfl5-QXur_zpYKJYFLNwNqAYdCAchX39oVXlGjdoWWomJIqw2GRbHqlx5h4bf0OWT0fM"/>
<div class="absolute -bottom-6 -left-6 bg-secondary-container p-4 rounded-xl shadow-lg transform rotate-6">
<span class="material-symbols-outlined text-on-secondary-container text-4xl" data-icon="pets">pets</span>
</div>
</div>
</div>
<!-- Central Bubbly Login Card -->
<div class="w-full max-w-md bubbly-gradient rounded-xl p-10 md:p-12 shadow-[0_30px_60px_-15px_rgba(145,69,57,0.12)] border border-white/40 backdrop-blur-sm relative overflow-hidden">
<!-- Branding -->
<div class="flex flex-col items-center mb-10">
<div class="w-16 h-16 bg-primary-container rounded-full flex items-center justify-center mb-6 shadow-lg transform hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-on-primary-container text-3xl" data-icon="favorite">favorite</span>
</div>
<h1 class="font-headline font-extrabold text-3xl text-primary tracking-tight text-center">Welcome back, Caretaker!</h1>
<p class="font-label text-on-surface-variant mt-2 text-center">Your fluffy friends are waiting for you.</p>
</div>
<!-- Login Form -->
<form class="space-y-6">
<!-- Username Field -->
<div class="space-y-2">
<label class="font-label text-sm font-semibold ml-4 text-primary">Caretaker ID</label>
<div class="relative group">
<div class="absolute inset-y-0 left-5 flex items-center pointer-events-none text-primary/40 group-focus-within:text-primary">
<span class="material-symbols-outlined" data-icon="person">person</span>
</div>
<input class="w-full bg-surface-container-high border-none rounded-md py-4 pl-14 pr-6 focus:ring-4 focus:ring-secondary-container/50 focus:bg-surface-container-lowest transition-all placeholder:text-outline-variant" placeholder="e.g. JoyfulPaws_01" type="text"/>
</div>
</div>
<!-- Password Field -->
<div class="space-y-2">
<div class="flex justify-between items-center px-4">
<label class="font-label text-sm font-semibold text-primary">Secret Paw-code</label>
<a class="text-xs font-semibold text-secondary hover:underline" href="#">Forgot?</a>
</div>
<div class="relative group">
<div class="absolute inset-y-0 left-5 flex items-center pointer-events-none text-primary/40 group-focus-within:text-primary">
<span class="material-symbols-outlined" data-icon="lock">lock</span>
</div>
<input class="w-full bg-surface-container-high border-none rounded-md py-4 pl-14 pr-14 focus:ring-4 focus:ring-secondary-container/50 focus:bg-surface-container-lowest transition-all placeholder:text-outline-variant" placeholder="••••••••" type="password"/>
<div class="absolute inset-y-0 right-5 flex items-center cursor-pointer text-primary/40 hover:text-primary">
<span class="material-symbols-outlined" data-icon="visibility">visibility</span>
</div>
</div>
</div>
<!-- Remember Me -->
<div class="flex items-center gap-3 px-4">
<input class="w-5 h-5 rounded border-outline-variant text-primary focus:ring-primary-container" id="remember" type="checkbox"/>
<label class="font-label text-sm text-on-surface-variant select-none" for="remember">Remember my cozy station</label>
</div>
<!-- Sign In Button -->
<button class="w-full bg-primary-container text-on-primary-container font-headline font-bold text-lg py-5 rounded-full shadow-[0_15px_30px_-5px_rgba(254,156,140,0.4)] hover:shadow-[0_20px_40px_-5px_rgba(254,156,140,0.6)] transform hover:-translate-y-1 active:scale-95 transition-all flex items-center justify-center gap-3" type="submit">
                    Sign In
                    <span class="material-symbols-outlined" data-icon="pets" data-weight="fill" style="font-variation-settings: 'FILL' 1;">pets</span>
</button>
</form>
<!-- Secondary Action -->
<div class="mt-10 pt-8 border-t border-primary/5 text-center">
<p class="font-label text-sm text-on-surface-variant">
                    New to the sanctuary? 
                    <a class="font-bold text-primary hover:text-primary-dim transition-colors ml-1" href="#">Join our family</a>
</p>
</div>
<!-- Bubbly Accents Inside Card -->
<div class="absolute -bottom-10 -right-10 w-32 h-32 bg-secondary-container/20 rounded-full blur-xl"></div>
<div class="absolute -top-10 -left-10 w-24 h-24 bg-tertiary-container/20 rounded-full blur-xl"></div>
</div>
<!-- Mobile/Tablet Illustration (Smaller Version) -->
<div class="lg:hidden flex gap-4 mt-8">
<div class="w-16 h-16 rounded-lg bg-surface-container-high flex items-center justify-center overflow-hidden rotate-3">
<img alt="Puppy" class="w-full h-full object-cover" data-alt="Cute puppy head tilted" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCOE1j-IVUclWmvHu_rErbCuH5oA65PZihiPcnOnleVxffcqEFN-vnFO7IbW6SfEOpocG3sPy8hjdZQtGz4q-6wgAvhJ-5w1SuvPHw-q0FajEZcRx-S0FQ3OtoIbd2nJy4WTPjDzUGMJp0sp3XuiH_LUOQYP3hxt0p-4nsY6TODjbsT6wWJGoe--xmjR432quIfu9hSB1jLvHtH5jwlKIrSJlL4wkuAYJVIua228kGpP3Dgc05aCSn7mBAVRwtqcBv8lhsIEI1tWHU"/>
</div>
<div class="w-16 h-16 rounded-lg bg-surface-container-high flex items-center justify-center overflow-hidden -rotate-6">
<img alt="Kitten" class="w-full h-full object-cover" data-alt="Cute kitten face" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDWA978_qUYS0fZa70E5LYzZG9RDgtz78re-5NDKB4KMA3UspIOEK-1MBZqSJtkHRrGK3V8Xv7lcljVmBp2bTx_ty39gz4Xt4LZpgbpjnFpWwg8TeRZwRLZo8G8qtw7Ov9K4h6Xw88Jzubm5P0-gHaphC40qkQQ8l_qfkyMwiOdy52tG_XHp2dts0dAi2QV-gIQWNw9bIXRcJJTp0VKZsrHZ12yDv5Mp0Ofsi4ZTzM-fjT15dKq1Ihkhx2klmbtRePonPcOz1NAd3k"/>
</div>
<div class="w-16 h-16 rounded-lg bg-surface-container-high flex items-center justify-center overflow-hidden rotate-12">
<img alt="Dog ears" class="w-full h-full object-cover" data-alt="Fluffy dog ears" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCmA_GsmZGesjqY_Lyfe6JT3Vloncz4I3RsWdgLBnq8ThZ6dQ1RrVk1JtQrQx8SWEeSAsgXsi1nm9AB30S_Joh5OrNhJLJPPGOAY1Jn3IleBQJR6uPx4FIFfYcFyWjP8vBYLlWGLYwEGJt5yNcfGXkfiG7g6nNz4YifrhXF2APaIgi3cJsIwSNKMl2diusQhcFSy5FlwVx5VY-g7Dq1HHClUeO_gNPSDf9lxZtecR96i6x1YikvX4FIcn6ghsEVaM7ba_xhk9vI_oc"/>
</div>
</div>
</main>
<!-- Bottom Footer Links -->
<footer class="fixed bottom-8 w-full text-center px-6">
<div class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-xs font-label text-outline uppercase tracking-widest opacity-60">
<a class="hover:text-primary transition-colors" href="#">Privacy Meadow</a>
<a class="hover:text-primary transition-colors" href="#">Safety Nest</a>
<a class="hover:text-primary transition-colors" href="#">Contact Humans</a>
</div>
</footer>
</body></html>